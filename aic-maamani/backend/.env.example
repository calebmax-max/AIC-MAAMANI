# Copy this file to .env and replace the values with your own deployment settings.
# Example MySQL URL for alwaysdata:
# DATABASE_URL=mysql+pymysql://username:password@mysql-username.alwaysdata.net:3306/database_name
DATABASE_URL=mysql+pymysql://calebtonny:modcom1234@mysql-calebtonny.alwaysdata.net:3306/calebtonny_aic_maamani

# CORS origins allowed by the backend API.
AIC_MAAMANI_CORS_ORIGINS=http://localhost:3000

# Session settings for admin authentication.
AIC_MAAMANI_SESSION_SECRET=change-this-to-a-long-random-string
AIC_MAAMANI_SESSION_SECURE=false
AIC_MAAMANI_SESSION_SAMESITE=lax
AIC_MAAMANI_SESSION_MAX_AGE_SECONDS=28800

# Frontend build can use this to reach the backend API.
# Create a frontend .env.local file in the React project if your frontend is deployed separately.
# REACT_APP_API_BASE_URL=https://your-backend-domain.com

# The backend automatically creates tables on startup with SQLAlchemy create_all().
